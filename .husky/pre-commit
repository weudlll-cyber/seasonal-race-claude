#!/usr/bin/env sh
# Run lint-staged on the client package before every commit.
# lint-staged auto-fixes ESLint errors and Prettier formatting on staged files.
# VERIFY-COST-3: the binary is invoked DIRECTLY. `npx lint-staged` re-resolves the package on every
# commit and that cost 1.35 s measured, for nothing — the binary is already installed and pinned by
# the lockfile. Falls back to npx if it is somehow absent, so a fresh clone still works.
cd client || exit 1
if [ -x node_modules/.bin/lint-staged ]; then
  node_modules/.bin/lint-staged || exit 1
else
  npx lint-staged || exit 1
fi
cd ..

# ONE-TRUTH-2 stage 6b: THE FAST GUARDS RUN HERE, AND THEIR COUNTS ARE PRINTED EXPLICITLY.
#
# A commit went in with a failing test because a SUMMARY LINE was read instead of a count. The hook
# is where that is cheapest to prevent, so the cheap guards run at commit time and the result is
# three labelled numbers rather than a wall of prose. Only guards costing well under a second are
# here — the suites and the fingerprints belong to `npm run verify`, not to every commit.
#
# It BLOCKS on failure (unlike the mint tripwire below, which only informs): these guards answer
# yes/no questions with no legitimate failing state. `git commit --no-verify` remains the escape.
#
# VERIFY-COST-3: THEY RUN IN PARALLEL NOW, AND NOTHING WAS CUT TO ACHIEVE IT.
#
# Measured sequentially: fingerprints 1649 ms, writable 783 ms, config-claims 355 ms, stamps 198 ms,
# doc-facts 138 ms, config-keys 119 ms — 3.4 s, of which one guard is half. All six are READ-ONLY and
# independent: each answers a yes/no question about the tree and none writes anything, so the order
# they run in was never load-bearing. Wall clock is now the slowest one rather than their sum.
#
# The OUTPUT is still deterministic: each guard writes to its own file and they are replayed in the
# fixed order below, so a failing run reads identically to the sequential version. That mattered —
# the reason these are here at all is that a summary line was once read instead of a count.
fast_fail=0
fast_pass=0
guards="scripts/check-fingerprints.mjs scripts/check-measured-stamps.mjs scripts/check-config-claims.mjs scripts/check-doc-facts.mjs scripts/check-writable.mjs scripts/check-config-keys.mjs scripts/check-fallback-agreement.mjs"

# STAMP-TRAP-1: the stamp guard runs against the STAGED tree HERE, and only here.
#
# Its ordinary mode reports a dirty dependency as PENDING - a REPORT, not a failure - which is right
# for an ad-hoc run and exactly wrong at commit time, because the stamp goes stale the instant the
# commit lands. That is what put master red twice on the day CONTENDER-ZOOM shipped: verify was run
# on an uncommitted camera change, printed PENDING, and read GREEN. The guard's own header warns
# about that path in prose; this is the line that makes it a rule.
guard_args() {
  case "$1" in
    scripts/check-measured-stamps.mjs) echo "--staged" ;;
    *) echo "" ;;
  esac
}
i=0
for guard in $guards
do
  i=$((i + 1))
  # shellcheck disable=SC2046 - guard_args returns a flag or nothing, and must word-split.
  node "$guard" $(guard_args "$guard") >"/tmp/ra-guard-$i.out" 2>&1 &
  eval "pid_$i=\$!"
done
i=0
for guard in $guards
do
  i=$((i + 1))
  # STAMP-TRAP-1: `wait` IS THE CONDITION, not a bare command followed by a $? test.
  #
  # Husky runs this script as `sh -e` (see .husky/_/h). Under -e a bare failing command aborts the
  # script immediately - so the moment any guard failed, the shell exited HERE, before the replay
  # below and before the "COMMIT BLOCKED" line. The hook refused the commit and could not say why:
  # the operator got `husky - pre-commit script failed (code 1)` and nothing else. A command used as
  # an `if` condition is exempt from -e, which is the whole fix.
  if eval "wait \$pid_$i"; then
    fast_pass=$((fast_pass + 1))
  else
    fast_fail=$((fast_fail + 1))
    echo ""
    sed 's/^/     /' "/tmp/ra-guard-$i.out"
  fi
  rm -f "/tmp/ra-guard-$i.out"
done
echo ""
echo "  GUARDS: PASS $fast_pass   FAIL $fast_fail"
if [ "$fast_fail" -gt 0 ]; then
  # LAST LINE ON FAILURE, deliberately: it is the line the terminal leaves on screen.
  echo ""
  echo "  COMMIT BLOCKED - $fast_fail guard(s) failed. Fix them, or commit with --no-verify."
  exit 1
fi

# VERIFY-FAST-1: the mint tripwire, delivered at the moment it applies.
#
# The rule lives in docs/SHIP-CEREMONY.md, and a rule a human reads on a busy day is exactly what
# stage 2 of the original tripwire was built to replace. This PRINTS — it never blocks — because
# "can this diff change the race?" is information the committer needs, not a veto: plenty of
# legitimate commits touch the engine and mint afterwards.
staged=$(git diff --cached --name-only)
if [ -n "$staged" ]; then
  if node scripts/engine-reach.mjs --check $staged >/dev/null 2>&1; then
    echo ""
    echo "  !  THIS DIFF CAN CHANGE THE RACE - mint before you ship:"
    node scripts/engine-reach.mjs --check $staged 2>/dev/null | sed 's/^/     /'
    echo "     node scripts/fingerprint-default.mjs   (compare against docs/fingerprints.json)"
    echo ""
  fi
fi
exit 0
