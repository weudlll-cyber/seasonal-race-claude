{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "_mode": "defaultMode is 'default' ON PURPOSE. The posture an unattended run needs — DENY an unapproved call instead of waiting on a human who is asleep — is wrong for an interactive one, so it belongs on the launcher (--permission-mode dontAsk, see docs/NIGHT-RUN.md) and not in a file both share. 'acceptEdits' was tried and is NOT enough: it auto-approves writes and a little filesystem work, and every other shell command still prompts, which is exactly where a night block stalls.",
    "defaultMode": "default",
    "allow": [
      "Read",
      "Write",
      "Edit",

      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm ci)",
      "Bash(npm ci *)",
      "Bash(npm install *)",
      "Bash(npm start)",
      "Bash(npm start *)",

      "Bash(node scripts/*)",
      "Bash(node -e *)",
      "Bash(node --input-type=module -e *)",
      "Bash(node -p *)",

      "Bash(npx vitest *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(npx playwright)",
      "Bash(npx playwright *)",
      "Bash(npx --yes playwright *)",
      "Bash(npx @playwright/test *)",
      "Bash(playwright)",
      "Bash(playwright *)",
      "Bash(npm run test:e2e)",
      "Bash(npm run test:e2e *)",
      "Bash(npm run test:e2e:ui)",
      "Bash(npm run test:e2e:ui *)",

      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git ls-files*)",
      "Bash(git check-ignore*)",
      "Bash(git rev-parse*)",
      "Bash(git tag*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git merge *)",
      "Bash(git push)",
      "Bash(git push origin *)",
      "Bash(git push -u origin *)",
      "Bash(git push origin --delete *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git worktree *)",
      "Bash(git stash*)",
      "Bash(git fetch*)",
      "Bash(git pull --ff-only*)",
      "Bash(git config --get*)",

      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(cd *)",
      "Bash(pwd)",
      "Bash(echo *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sort *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(for *)",
      "Bash(sleep *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(python *)",
      "Bash(bash *)",
      "Bash(prettier *)",
      "Bash(eslint *)",

      "Bash(powershell -Command \"Get-Process*)",
      "Bash(powershell -Command \"Get-NetTCPConnection*)",
      "Bash(powershell -Command \"Stop-Process*)",
      "Bash(powershell -Command \"Add-Type*)",
      "Bash(tasklist)",
      "Bash(taskkill *)",
      "Bash(netstat *)",

      "mcp__playwright__browser_click",
      "mcp__playwright__browser_close",
      "mcp__playwright__browser_console_messages",
      "mcp__playwright__browser_drag",
      "mcp__playwright__browser_drop",
      "mcp__playwright__browser_evaluate",
      "mcp__playwright__browser_file_upload",
      "mcp__playwright__browser_fill_form",
      "mcp__playwright__browser_find",
      "mcp__playwright__browser_handle_dialog",
      "mcp__playwright__browser_hover",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_navigate_back",
      "mcp__playwright__browser_network_request",
      "mcp__playwright__browser_network_requests",
      "mcp__playwright__browser_press_key",
      "mcp__playwright__browser_resize",
      "mcp__playwright__browser_run_code",
      "mcp__playwright__browser_run_code_unsafe",
      "mcp__playwright__browser_select_option",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_tabs",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_type",
      "mcp__playwright__browser_wait_for",

      "WebFetch(domain:localhost)",
      "Skill(run)",
      "Skill(run:*)",
      "Skill(dev-start)",
      "Skill(update-config)",
      "Skill(update-config:*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git rebase*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(git reflog delete*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fdx*)",
      "Bash(git update-ref -d *)",

      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf .git*)",
      "Bash(rm -rf server/data*)",
      "Bash(rm -rf client/src*)",
      "Bash(rm -rf docs*)",
      "Bash(rm -rf scripts*)",
      "Bash(rmdir /s*)",
      "Bash(del /f*)",

      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*secret*)",
      "Read(**/id_rsa*)",
      "Read(**/users.json)",
      "Read(**/*.pem)",
      "Bash(cat *.env*)",
      "Bash(cat *users.json*)",

      "Bash(curl *)",
      "Bash(wget *)"
    ]
  }
}
