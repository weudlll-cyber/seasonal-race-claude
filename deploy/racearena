#!/usr/bin/env bash
# ============================================================
# File:        racearena
# Path:        deploy/racearena   (installed to /usr/local/bin/racearena by deploy/install.sh)
# Project:     RaceArena — VPS-INSTALL-1 (2026-10-07)
# Description: The one command an operator of a single-server install uses: status, logs, backup,
#              restore, update, rollback, version, harden-ssh, backup-copy, uninstall. Every command
#              explains itself with --help.
#
# ★ THE TOOLS ARE THE PROJECT'S OWN, run in a one-off container of the app image (the host has no
#   Node): scripts/backup.mjs (backup and restore), scripts/migrate.mjs (migrations),
#   scripts/status.mjs (the status check), and deploy/ra-admin.mjs for the HTTP steps. Nothing here
#   re-implements what they do; this file only orders them and decides what happens when one fails.
#
# ★ install.sh calls THIS FILE for every step that touches the stack (start, first-admin,
#   verify-signin), so a test of these commands is a test of the install's own code path.
#
# The places, with their production defaults. The variables exist so a test can point them at
# its own directories; on a server nothing sets them.
#   RA_HOME     /opt/racearena            the checkout (git), and deploy/ in it
#   RA_ETC      /etc/racearena            settings: racearena.env (600), Caddyfile, compose.env, state
#   RA_DATA     /var/lib/racearena        the data directory (mounted at /app/data)
#   RA_BACKUPS  /var/backups/racearena    the backups (mounted at /backups)
#
# ★ WEBSITE MODE (WEBSITE-EMBED-1 piece 5b, 2026-11-11): when $RA_ETC/mode says "website", the race
#   runs inside Seasonal Entertainment — the app alone (no Caddy of its own, no 80/443), under
#   /games/race, behind the website's proxy and its route file (deploy/website-route.sh). Its
#   settings are $RA_ETC/website.conf (no secret) and the generated compose overlay
#   $RA_ETC/compose.website.yml; every command below takes the mode from there, so an update keeps it.
#
# ★ THE COPY OFF THE SERVER (GOING-ONLINE-PREP-1 piece 3, 2026-11-13): `racearena backup-copy setup`
#   switches on an encrypted copy of every backup to the owner's OneDrive (rclone). OFF until then,
#   in both modes; its section below says how.
# ============================================================
set -euo pipefail

RA_HOME="${RA_HOME:-/opt/racearena}"
RA_ETC="${RA_ETC:-/etc/racearena}"
RA_DATA="${RA_DATA:-/var/lib/racearena}"
RA_BACKUPS="${RA_BACKUPS:-/var/backups/racearena}"
REPO_URL="https://github.com/weudlll-cyber/seasonal-race-claude.git"
BACKUP_KEEP_DAYS=14
HEALTH_TIMEOUT_S=120
# The app image runs as `node`, uid 1000 (server/Dockerfile); its two host directories must be its own.
APP_UID=1000

say() { printf '%s\n' "$*"; }
die() { printf 'racearena: %s\n' "$*" >&2; exit 1; }

compose() {
  if website_mode; then
    write_website_overlay
    docker compose -p racearena -f "$RA_HOME/deploy/docker-compose.prod.yml" -f "$RA_ETC/compose.website.yml" \
      --env-file "$RA_ETC/compose.env" "$@"
  else
    docker compose -p racearena -f "$RA_HOME/deploy/docker-compose.prod.yml" --env-file "$RA_ETC/compose.env" "$@"
  fi
}

# ── website mode ──────────────────────────────────────────────────────────────────────────────────
website_mode() { [[ "$(cat "$RA_ETC/mode" 2>/dev/null)" == website ]]; }
load_website_conf() {
  # shellcheck disable=SC1091
  . "$RA_ETC/website.conf"
}

# The compose overlay of website mode, from website.conf — rewritten before every compose call, so it
# always matches the settings and this version. The app: the base path's health check, the secret and
# the sync token mounted read-only, the race's own network with its fixed subnet (nginx mode: the
# trusted proxy, its gateway being the peer the published port's connections come from), and the
# website's network (the feed at site:3800; in Caddy mode also where the website's Caddy reaches the
# race, as "racearena" — the network that is trusted there, as for Bingo). nginx mode publishes the
# port on 127.0.0.1 only.
write_website_overlay() {
  load_website_conf
  {
    printf '# Generated by racearena (website mode) from %s — do not edit.\n' "$RA_ETC/website.conf"
    printf 'services:\n  app:\n'
    printf '    healthcheck:\n'
    printf '      test: ["CMD", "node", "-e", "fetch('"'"'http://127.0.0.1:4000/games/race/api/health'"'"').then(r=>{process.exitCode=r.ok?0:1}).catch(()=>{process.exitCode=1})"]\n'
    printf '    volumes:\n'
    printf '      - %s:/run/racearena/proxy-secret:ro\n' "$RA_ETC/website/proxy-secret"
    printf '      - %s:/run/racearena/sync-token:ro\n' "$RA_ETC/website/sync-token"
    printf '    networks:\n      default: {}\n      site:\n        aliases: [racearena]\n'
    if [[ "$PROXY" == nginx ]]; then printf '    ports:\n      - "127.0.0.1:%s:4000"\n' "$LOCAL_PORT"; fi
    printf 'networks:\n  default:\n    ipam:\n      config:\n        - subnet: %s\n' "$SUBNET"
    printf '  site:\n    external: true\n    name: %s\n' "$SITE_NETWORK"
  } >"$RA_ETC/compose.website.yml.tmp"
  mv -f "$RA_ETC/compose.website.yml.tmp" "$RA_ETC/compose.website.yml"
}

# The website's sync token (root-only, one for all games) as the race's own read-only copy for its
# app user — taken again at every start and update, so a token the website renews is picked up.
refresh_sync_token() {
  load_website_conf
  [[ -r "$SITE_TOKEN" ]] || die "the website's sync token $SITE_TOKEN cannot be read"
  install -m 400 -o "$APP_UID" -g "$APP_UID" "$SITE_TOKEN" "$RA_ETC/website/sync-token"
}


# The route file's state: present, owner-only, and equal to what this version would write.
route_state() {
  load_website_conf
  local f="$ROUTES_DIR/$ROUTE_FILE" want
  if [[ ! -f "$f" ]]; then say "route file: MISSING ($f) — racearena route install"; return 1; fi
  want="$(bash "$RA_HOME/deploy/website-route.sh" render --proxy "$PROXY" --race "$RACE_UPSTREAM" --auth "$AUTH_UPSTREAM" --secret-file "$RA_ETC/website/proxy-secret")"
  if [[ "$want" == "$(cat "$f")" ]]; then
    say "route file: $f — current (mode $(stat -c %a "$f"), in the website's $PROXY)"
  else
    say "route file: $f — DIFFERS from what this version writes — racearena route install"
    return 1
  fi
}

# The image tag is the checked-out commit, so a rollback can reuse the previous image.
current_sha() { git -C "$RA_HOME" rev-parse --short=12 HEAD; }
export_image_tag() { RA_IMAGE_TAG="$(current_sha)"; export RA_IMAGE_TAG; }

# A one-off container of the app image: its settings, its data and backup mounts, on its network.
tool() { compose run --rm --no-deps -T "$@"; }

# Caddy's own root certificate when it signs for itself (`tls internal`, the local test). With a
# public certificate the file does not exist and nothing is added.
caddy_local_ca() {
  # </dev/null: `exec` reads standard input, and a password on its way to ra-admin must not be swallowed here.
  compose exec -T caddy cat /data/caddy/pki/authorities/local/root.crt 2>/dev/null </dev/null || true
}

# The HTTP helper, deploy/ra-admin.mjs, in a one-off container. Standard input is passed through:
# the password reaches it there and nowhere else.
ra_admin() {
  tool -v "$RA_HOME/deploy:/deploy:ro" -e "RA_EXTRA_CA=$(caddy_local_ca)" app node /deploy/ra-admin.mjs "$@"
}

# Caddy waits for the app to be healthy, so `up` itself fails while the app is not. That is not the
# verdict: wait_healthy decides, and an update rolls back on it. When `up` fails this way it does not
# start Caddy at all, and nothing would start it later — wait_healthy does, once the app is healthy.
up_detached() {
  if website_mode; then
    # The app only: the compose file's Caddy is the standalone install's, never started here.
    compose up -d app || say "(the app is not healthy yet — the health check decides)"
  else
    compose up -d || say "(the app is not healthy yet — the health check decides)"
  fi
}

state_get() { cat "$RA_ETC/state/$1" 2>/dev/null || true; }
state_set() { mkdir -p "$RA_ETC/state"; printf '%s\n' "$2" > "$RA_ETC/state/$1"; }

require_installed() {
  [[ -f "$RA_ETC/compose.env" && -d "$RA_HOME/.git" ]] || die "no install found ($RA_ETC/compose.env, $RA_HOME). Run install.sh first."
}

app_health_status() {
  local id
  id="$(compose ps -q app 2>/dev/null || true)"
  [[ -n "$id" ]] || { echo "absent"; return; }
  docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$id"
}

caddy_running() {
  local id
  id="$(compose ps -q caddy 2>/dev/null || true)"
  [[ -n "$id" && "$(docker inspect -f '{{.State.Running}}' "$id" 2>/dev/null)" == "true" ]]
}

# Healthy means BOTH: the container's own check passes, and /api/health answers through Caddy over
# https — what a visitor reaches. Gives up after HEALTH_TIMEOUT_S seconds.
#
# ★ A SLOW START (VPS-INSTALL-1, 2026-10-22). The app's health window in the compose file is its
# start period plus three failed checks; a start that takes longer — the first one copies the seed
# files into an empty data directory before the server listens, and a busy host stretches that — is
# marked unhealthy, and `compose up` then gives up on Caddy for good. The app turns healthy a few
# seconds later on its own, but with no Caddy https never answers and the start failed after the
# whole bound (2 of 8 empty-data starts in the installer test). So once the app is healthy and Caddy
# is not running, the stack is brought up again. The bound is unchanged: a version that never
# becomes healthy still fails here, and an update still rolls back on it.
wait_healthy() {
  local start=$SECONDS status
  local deadline=$((start + HEALTH_TIMEOUT_S)) next_report=$((start + 15))
  while ((SECONDS < deadline)); do
    status="$(app_health_status)"
    if [[ "$status" == "healthy" ]] && website_mode; then
      # Website mode: the app's own check on /games/race/api/health; the website's proxy is in front.
      say "healthy: the app answers (inside Seasonal Entertainment, behind the website's proxy)"
      return 0
    fi
    if [[ "$status" == "healthy" ]]; then
      if ! caddy_running; then
        say "the app is healthy; starting Caddy, which the first 'up' gave up on"
        compose up -d >/dev/null 2>&1 || true
      fi
      if ra_admin health --https >/dev/null 2>&1; then
        say "healthy: the app answers, and https through Caddy answers"
        return 0
      fi
    fi
    if ((SECONDS >= next_report)); then
      say "waiting: the app is ${status} ($((SECONDS - start))s of ${HEALTH_TIMEOUT_S}s)"
      next_report=$((SECONDS + 15))
    fi
    sleep 5
  done
  return 1
}

# The newest release tag: v<major>.<minor>[.<patch>]. ★ NOT every tag starting with "v": this
# repository carries dozens of ship markers (v-…-complete) that are not releases.
newest_release_tag() {
  git ls-remote --tags --refs "$REPO_URL" 'v*' | sed 's|.*refs/tags/||' |
    grep -E '^v[0-9]+\.[0-9]+(\.[0-9]+)?$' | sort -V | tail -n 1 || true
}

# A tag, a branch or a commit → the commit it names, after fetching.
resolve_ref() {
  local ref="$1"
  git -C "$RA_HOME" fetch --quiet --tags origin
  git -C "$RA_HOME" rev-parse --verify --quiet "origin/$ref^{commit}" ||
    git -C "$RA_HOME" rev-parse --verify --quiet "$ref^{commit}" ||
    die "no tag, branch or commit called '$ref'"
}

# ── commands ─────────────────────────────────────────────────────────────────────────────────────

help_status() { say "racearena status — is this install healthy?
  The project's status check (scripts/status.mjs): the app answers, free disk at the data
  directory, the data directory is writable, the newest backup is recent and intact. Then the
  two containers, https through Caddy, and any alerts of the last 24 hours.
  Exit 0 when everything passed, 1 when something failed."; }
cmd_status() {
  require_installed
  export_image_tag
  local rc=0
  if website_mode; then
    say "── mode: inside Seasonal Entertainment (website mode), under /games/race"
    say "── the status check (scripts/status.mjs)"
    tool app node /scripts/status.mjs --url http://app:4000/games/race --backups /backups || rc=1
    say "── containers"
    compose ps --format '{{.Service}}: {{.Status}}' || rc=1
    say "── the route in the website's proxy"
    route_state || rc=1
  else
    say "── the status check (scripts/status.mjs)"
    tool app node /scripts/status.mjs --url http://app:4000 --backups /backups || rc=1
    say "── containers"
    compose ps --format '{{.Service}}: {{.Status}}' || rc=1
    say "── https"
    ra_admin health --https || rc=1
  fi
  # The copy off the server (piece 3), only once it is set up. From this server's own record, not from
  # the OneDrive: the 10-minute alert timer runs this, and a short network outage is not a stale copy
  # (`racearena backup-copy status` reads the copy itself).
  if copy_configured; then
    say "── the copy off the server"
    local last
    last="$(state_get last-copy)"
    if [[ -z "$last" ]]; then
      say "WARNING: nothing has been copied off the server yet"; rc=1
    else
      say "last copied: $last — $(copy_age_hours "$last") hours old"
      if [[ "$(archive_stamp "$last")" < "$(backup_cutoff "$COPY_STALE_DAYS")" ]]; then
        say "WARNING: the newest copy off the server is older than $COPY_STALE_DAYS days"; rc=1
      fi
    fi
  fi
  # The SSH jail (install.sh step 4b). Shown, not judged: a missing jail is a hardening gap, not an
  # unhealthy app, so it never fails the status check.
  if command -v fail2ban-client >/dev/null 2>&1; then
    say "── fail2ban (SSH: 5 tries, 1 hour)"
    fail2ban-client status sshd 2>/dev/null | grep -E 'Currently (failed|banned)|Total banned' ||
      say "the sshd jail is not running — re-run install.sh, or: systemctl restart fail2ban"
  fi
  if command -v journalctl >/dev/null 2>&1; then
    say "── alerts in the last 24 hours (journal tag racearena-alert)"
    journalctl -t racearena-alert --since '-24h' --no-pager -q -o short-iso 2>/dev/null | tail -n 5 || true
  fi
  return "$rc"
}

help_logs() { say "racearena logs [app|caddy] [-f] — the containers' logs (the last 200 lines; -f follows).
  Both rotate at 10 MB, five files each."; }
cmd_logs() {
  require_installed
  export_image_tag
  local follow=() svc=()
  for a in "$@"; do
    case "$a" in -f) follow=(-f) ;; app | caddy) svc=("$a") ;; *) die "unknown argument: $a" ;; esac
  done
  compose logs --tail 200 "${follow[@]}" "${svc[@]}"
}

help_backup() { say "racearena backup — one archive of all the data, taken while the app runs.
  The project's backup tool (scripts/backup.mjs) writes racearena-backup-<UTC>.tar and its .sha256
  into $RA_BACKUPS, then archives older than $BACKUP_KEEP_DAYS days are deleted (by the date in
  their name). Copy backups OFF this server as well: a copy on the same disk does not survive
  losing the disk."; }
cmd_backup() {
  require_installed
  export_image_tag
  local out name
  out="$(tool app node /scripts/backup.mjs --out /backups)"
  say "$out"
  name="$(printf '%s\n' "$out" | grep -o 'racearena-backup-[0-9TZ]*\.tar' | tail -n 1)"
  [[ -n "$name" ]] || die "the backup tool did not name an archive"
  state_set last-backup "$name"
  prune_backups
  say "backup: $RA_BACKUPS/$name"
  # Off the server too, once `racearena backup-copy setup` has run; nothing at all before that.
  copy_after_backup "$name"
}

# The UTC stamp in an archive's name ("racearena-backup-<stamp>.tar"), and the stamp N days ago.
# Shared by this disk's retention and the copy's (copy_archive), so both age a backup the same way.
archive_stamp() {
  local b
  b="$(basename "$1" .tar)"
  printf '%s\n' "${b#racearena-backup-}"
}
backup_cutoff() { date -u -d "-$1 days" +%Y%m%dT%H%M%SZ; }

prune_backups() {
  # The age comes from the NAME, as scripts/status.mjs reads it, never from the file's mtime: a copy
  # resets the mtime and would make a stale backup look fresh (status.mjs header).
  local cutoff f
  cutoff="$(backup_cutoff "$BACKUP_KEEP_DAYS")"
  for f in "$RA_BACKUPS"/racearena-backup-*.tar; do
    [[ -e "$f" ]] || continue
    if [[ "$(archive_stamp "$f")" < "$cutoff" ]]; then
      rm -f -- "$f" "$f.sha256"
      say "removed (older than $BACKUP_KEEP_DAYS days): $(basename "$f")"
    fi
  done
}

# ── the copy OFF the server (GOING-ONLINE-PREP-1 piece 3, the owner's decision D4 of 2026-11-13) ──
# After each backup the new archive and its .sha256 are copied to an rclone remote — the owner's
# OneDrive — through an rclone CRYPT layer, so what is stored there is encrypted, names included,
# and the copy keeps the same 14 days as this disk, by the date in the name (backup_cutoff).
# It is OFF until `racearena backup-copy setup` has run: without $COPY_DIR/rclone.conf nothing below
# runs, rclone is not even looked for, and every command behaves exactly as before.
#
# ★ THE CRYPT PASSWORD is generated at setup, stored root-only (0600) in $COPY_DIR/crypt-password,
#   and shown ONCE — on the operator's own terminal (/dev/tty) only, never on standard output, so it
#   reaches no log, no journal and no test output. Without it the copies cannot be opened. rclone
#   holds it in rclone.conf in its reversible "obscured" form, so that file is 0600 too.
# ★ RA_RCLONE names the rclone binary (default: rclone, which setup installs from the distribution's
#   signed package repository). Like RA_HOME and the others it exists for a test; a server sets none.
COPY_DIR="$RA_ETC/backup-copy"
COPY_CONF="$COPY_DIR/rclone.conf"   # setup points this at a temporary file while it builds it
COPY_REMOTE=racearena-copy          # the crypt remote in rclone.conf
COPY_BASE_REMOTE=onedrive           # what it encrypts onto: the owner's OneDrive
COPY_FOLDER=RaceArena-backups       # the folder on the OneDrive
COPY_STALE_DAYS=2                   # status warns when the newest copy is older (BACKLOG's verify bar)

copy_configured() { [[ -f "$COPY_DIR/rclone.conf" ]]; }
rclone_run() { "${RA_RCLONE:-rclone}" --config "$COPY_CONF" "$@"; }

# The archives in the copy, oldest first: rclone shows the decrypted names, and name order is date order.
copy_list() { rclone_run lsf --files-only --include 'racearena-backup-*.tar' "$COPY_REMOTE:" | sort; }

# Copy one archive and its checksum, then prune the copy the way prune_backups prunes this disk.
copy_archive() {
  local name="$1" f cutoff
  rclone_run copyto "$RA_BACKUPS/$name" "$COPY_REMOTE:$name" || return 1
  if [[ -f "$RA_BACKUPS/$name.sha256" ]]; then
    rclone_run copyto "$RA_BACKUPS/$name.sha256" "$COPY_REMOTE:$name.sha256" || return 1
  fi
  state_set last-copy "$name"
  say "copied off the server: $name"
  cutoff="$(backup_cutoff "$BACKUP_KEEP_DAYS")"
  while IFS= read -r f; do
    [[ -n "$f" && "$(archive_stamp "$f")" < "$cutoff" ]] || continue
    rclone_run deletefile "$COPY_REMOTE:$f" || return 1
    rclone_run deletefile "$COPY_REMOTE:$f.sha256" 2>/dev/null || true
    say "removed from the copy (older than $BACKUP_KEEP_DAYS days): $f"
  done < <(copy_list)
}

# After a backup. A failed copy never fails the backup (an update or an uninstall must not stop on
# the network): it is said, written to the journal, and `status` turns red after 2 days.
copy_after_backup() {
  copy_configured || return 0
  copy_archive "$1" && return 0
  say "WARNING: the backup was NOT copied off the server — see: racearena backup-copy status" >&2
  if command -v logger >/dev/null 2>&1; then
    logger -t racearena-alert -p user.err "the backup $1 was not copied off the server" || true
  fi
  return 0
}

# The age of an archive, from the date in its name, in whole hours.
copy_age_hours() {
  local s
  s="$(archive_stamp "$1")"
  s="${s:0:4}-${s:4:2}-${s:6:2} ${s:9:2}:${s:11:2}:${s:13:2} UTC"
  printf '%s\n' "$((($(date -u +%s) - $(date -u -d "$s" +%s)) / 3600))"
}

# The newest copy and its age. Returns 1 when there is none, it cannot be read, or it is too old.
copy_status() {
  local list newest
  if ! list="$(copy_list)"; then
    say "WARNING: the copy cannot be read — check the network, then: racearena backup-copy test"
    return 1
  fi
  newest="$(tail -n 1 <<<"$list")"
  if [[ -z "$newest" ]]; then
    say "WARNING: there is no archive in the copy yet"
    return 1
  fi
  say "newest copy: $newest — $(copy_age_hours "$newest") hours old ($(grep -c . <<<"$list") archive(s) in the copy)"
  if [[ "$(archive_stamp "$newest")" < "$(backup_cutoff "$COPY_STALE_DAYS")" ]]; then
    say "WARNING: the newest copy off the server is older than $COPY_STALE_DAYS days"
    return 1
  fi
}

# One small file written to the copy, read back, compared and removed.
copy_roundtrip() {
  local probe got
  probe="racearena-copy-test $(date -u +%Y%m%dT%H%M%SZ) $(head -c 12 /dev/urandom | od -An -tx1 | tr -d ' \n')"
  printf '%s\n' "$probe" | rclone_run rcat "$COPY_REMOTE:racearena-copy-test.txt" || return 1
  got="$(rclone_run cat "$COPY_REMOTE:racearena-copy-test.txt")" || return 1
  rclone_run deletefile "$COPY_REMOTE:racearena-copy-test.txt" || return 1
  [[ "$got" == "$probe" ]] || { say "the file read back is not the file written"; return 1; }
  say "test copy: written, read back identical, removed"
}

# rclone from the distribution's package repository (signed by the distribution), when absent.
copy_install_rclone() {
  command -v "${RA_RCLONE:-rclone}" >/dev/null 2>&1 && return 0
  command -v apt-get >/dev/null 2>&1 ||
    die "rclone is not installed and this system has no apt-get — install rclone, then run this again"
  say "installing rclone from the distribution's package repository"
  DEBIAN_FRONTEND=noninteractive apt-get install -y -q rclone >/dev/null ||
    die "apt-get could not install rclone (try: apt-get update, then this again)"
}

# The OneDrive remote on a server without a browser: the token comes from `rclone authorize` on the
# owner's own PC — rclone's documented way for a headless machine.
copy_onedrive_remote() {
  [[ -t 0 ]] || die "the OneDrive authorisation needs your terminal: run this on the server yourself"
  say "
OneDrive authorisation (a server has no browser, so your PC does this part):
  1. On your PC install rclone (https://rclone.org/downloads/) and run:
         rclone authorize \"onedrive\"
     A browser opens: sign in to the Microsoft account whose OneDrive is to hold the copies.
  2. rclone then prints a token between two lines of arrows. Copy all of it, from { to }.
  3. Paste it here on one line and press Enter (it is not shown):"
  local token
  read -r -s -p "token: " token </dev/tty
  printf '\n' >/dev/tty
  [[ "$token" == "{"*"}" ]] || die "that is not the token rclone prints ({...}); nothing was set up"
  # rclone stores the token in the 0600 config file; it is never printed.
  rclone_run config create "$COPY_BASE_REMOTE" onedrive token "$token" config_type onedrive >/dev/null ||
    die "rclone could not create the OneDrive remote with that token; nothing was set up"
  rclone_run lsd "$COPY_BASE_REMOTE:" >/dev/null || die "the OneDrive cannot be read with that token; nothing was set up"
  say "the OneDrive answers"
}

# Show the password ONCE, on the operator's own terminal only — never on standard output.
copy_show_password() {
  local pw="$1" answer
  if ! { [[ -t 0 ]] && : >/dev/tty; } 2>/dev/null; then
    say "no terminal: the crypt password was NOT shown. Read it once, on your own terminal:
    sudo cat $COPY_DIR/crypt-password
and store it safely — without it the copies cannot be opened."
    return 0
  fi
  {
    printf '\n★ THE CRYPT PASSWORD of the copies — shown once, here only:\n\n    %s\n\n' "$pw"
    printf 'Store it safely NOW (a password manager, or on paper) — not only on this server.\n'
    printf 'Without it the copies on the OneDrive cannot be opened, not even by you.\n'
  } >/dev/tty
  until [[ "${answer:-}" == saved ]]; do
    read -r -p "type: saved — once you have stored it: " answer </dev/tty
  done
  printf '\033[2J\033[H' >/dev/tty # clear the screen, so the password does not stay on it
}

help_backup_copy() { say "racearena backup-copy setup|status|test|fetch — copy the backups OFF this server, encrypted.
  setup [--existing] [--local <dir>]
           once, by you, on the server: installs rclone, connects your OneDrive (you run
           rclone authorize \"onedrive\" on your PC and paste its token here), adds the encryption
           with a NEW password shown ONCE on your terminal, then writes a test copy and reads it back.
           From then on every backup — the daily one too — is copied to $COPY_FOLDER on the
           OneDrive, encrypted, and the copy keeps $BACKUP_KEEP_DAYS days as this disk does.
           --existing    type in the password of an earlier install instead (a new server that is
                         to read the old copies);
           --local <dir> a directory instead of the OneDrive (a second disk, or a test).
  status   the newest copy and its age; exit 1 when it is older than $COPY_STALE_DAYS days or cannot be read.
  test     a small file written to the copy, read back, removed.
  fetch <archive>|--newest
           an archive brought back from the copy into $RA_BACKUPS, checked against its
           checksum; then: racearena restore <archive>."; }
cmd_backup_copy() {
  local sub="${1:-}"
  [[ $# -gt 0 ]] && shift
  case "$sub" in
    setup) copy_setup "$@" ;;
    status)
      copy_configured || { say "the copy off the server is not set up — racearena backup-copy setup"; return 1; }
      copy_status
      ;;
    test)
      copy_configured || die "the copy off the server is not set up — racearena backup-copy setup"
      copy_roundtrip
      ;;
    fetch) copy_fetch "$@" ;;
    *) help_backup_copy; return 2 ;;
  esac
}

copy_setup() {
  local local_dir="" existing=0 pw target
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --local) local_dir="${2:-}"; [[ -n "$local_dir" ]] || die "--local needs a directory"; shift 2 ;;
      --existing) existing=1; shift ;;
      *) die "unknown argument: $1 (see: racearena backup-copy --help)" ;;
    esac
  done
  require_installed
  [[ "$(id -u)" == 0 ]] || die "run it as root: sudo racearena backup-copy setup"
  copy_configured && die "the copy is already set up ($COPY_DIR). To start again, move that folder aside first."
  say "── 1/4 rclone"
  copy_install_rclone
  "${RA_RCLONE:-rclone}" version 2>/dev/null | head -n 1
  # Built in a temporary file: a setup that stops half-way leaves nothing that counts as set up.
  mkdir -p "$COPY_DIR"
  chmod 700 "$COPY_DIR"
  COPY_CONF="$COPY_DIR/rclone.conf.new"
  (umask 077 && : >"$COPY_CONF")
  say "── 2/4 where the copies go"
  if [[ -n "$local_dir" ]]; then
    mkdir -p "$local_dir"
    target="$local_dir"
    say "a directory: $target"
  else
    copy_onedrive_remote
    target="$COPY_BASE_REMOTE:$COPY_FOLDER"
  fi
  say "── 3/4 the encryption"
  if ((existing)); then
    [[ -t 0 ]] || die "--existing needs your terminal, to type the password in"
    read -r -s -p "the crypt password of the earlier install: " pw </dev/tty
    printf '\n' >/dev/tty
    [[ -n "$pw" ]] || die "no password typed; nothing was set up"
  else
    pw="$(head -c 24 /dev/urandom | base64 | tr -d '/+=\n')"
  fi
  (umask 077 && printf '%s\n' "$pw" >"$COPY_DIR/crypt-password")
  # The obscured form goes in on standard input and straight into the file: the password is never
  # on a command line, where any user could read it in the process list.
  {
    printf '\n[%s]\ntype = crypt\nremote = %s\nfilename_encryption = standard\ndirectory_name_encryption = true\n' \
      "$COPY_REMOTE" "$target"
    printf 'password = %s\n' "$(printf '%s' "$pw" | rclone_run obscure -)"
  } >>"$COPY_CONF"
  ((existing)) || copy_show_password "$pw"
  pw=""
  mv -f "$COPY_CONF" "$COPY_DIR/rclone.conf"
  COPY_CONF="$COPY_DIR/rclone.conf"
  say "encrypted remote $COPY_REMOTE over $target; its password in $COPY_DIR/crypt-password (root only)"
  say "── 4/4 a test copy, read back"
  if ! copy_roundtrip; then
    mv -f "$COPY_CONF" "$COPY_DIR/rclone.conf.failed"
    die "the test copy failed; the copy is NOT switched on ($COPY_DIR/rclone.conf.failed is kept to look at)"
  fi
  state_set backup-copy-setup "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  say "the copy off the server is ON: every backup from now on is copied, encrypted, and kept $BACKUP_KEEP_DAYS days.
Check it any time with: racearena backup-copy status"
}

copy_fetch() {
  copy_configured || die "the copy off the server is not set up — racearena backup-copy setup"
  local name="${1:-}"
  [[ -n "$name" ]] || die "usage: racearena backup-copy fetch <archive>|--newest"
  [[ "$name" == --newest ]] && name="$(copy_list | tail -n 1)"
  name="$(basename "$name")"
  [[ "$name" == racearena-backup-*.tar ]] || die "not an archive name: $name"
  mkdir -p "$RA_BACKUPS"
  rclone_run copyto "$COPY_REMOTE:$name" "$RA_BACKUPS/$name" || die "could not fetch $name from the copy"
  if rclone_run copyto "$COPY_REMOTE:$name.sha256" "$RA_BACKUPS/$name.sha256" 2>/dev/null; then
    (cd "$RA_BACKUPS" && sha256sum -c --quiet "$name.sha256") || die "the fetched archive does not match its checksum: $name"
    say "fetched and checked against its checksum: $RA_BACKUPS/$name"
  else
    say "fetched (the copy holds no checksum for it): $RA_BACKUPS/$name"
  fi
  say "to put it back: racearena restore $name"
}

help_restore() { say "racearena restore <archive> — put the data back from a backup.
  <archive> is a file name in $RA_BACKUPS (or a path inside it). The app is stopped, the current
  data is MOVED aside to $RA_DATA.before-restore-<UTC> (kept, not deleted), the archive is
  restored with the project's backup tool into the empty directory, the app is started and its
  health is checked."; }
cmd_restore() {
  require_installed
  export_image_tag
  [[ $# -eq 1 ]] || die "usage: racearena restore <archive>"
  local name
  name="$(basename "$1")"
  [[ -f "$RA_BACKUPS/$name" ]] || die "no such archive in $RA_BACKUPS: $name"
  if [[ -f "$RA_BACKUPS/$name.sha256" ]] && command -v sha256sum >/dev/null 2>&1; then
    (cd "$RA_BACKUPS" && sha256sum -c --quiet "$name.sha256") || die "the archive does not match its checksum: $name"
  fi
  restore_archive "$name"
  wait_healthy || die "restored, but the app is not healthy within ${HEALTH_TIMEOUT_S}s — see: racearena logs app"
}

restore_archive() {
  local name="$1" aside
  say "stopping the app"
  compose stop app
  aside="$RA_DATA.before-restore-$(date -u +%Y%m%dT%H%M%SZ)"
  mv -- "$RA_DATA" "$aside"
  mkdir -p -- "$RA_DATA"
  if [[ "$(id -u)" == 0 ]]; then chown "$APP_UID:$APP_UID" "$RA_DATA"; fi
  # Owner-only, as install.sh lays it out (AUDIT-1 A5M-06); a restore must not loosen it.
  chmod 700 -- "$RA_DATA"
  say "the data before the restore is kept in $aside"
  tool app node /scripts/backup.mjs --restore "/backups/$name" --into /app/data
  say "starting the app"
  up_detached
}

help_update() { say "racearena update [ref] — move to another version, safely.
  [ref] is a tag, branch or commit; without it, the newest release tag (v<major>.<minor>[.<patch>]).
  Order: a backup first → fetch the ref → build its image → stop the app → run the project's
  migrations (scripts/migrate.mjs) → start → health check. If the app is not healthy within
  ${HEALTH_TIMEOUT_S} seconds, it goes back BY ITSELF to the previous version and to the backup taken
  at the start, and says so."; }
cmd_update() {
  require_installed
  local ref="${1:-}" target prev archive
  if [[ -z "$ref" ]]; then
    ref="$(newest_release_tag)"
    [[ -n "$ref" ]] || die "no release tag (v<major>.<minor>[.<patch>]) exists yet — name one: racearena update <ref>"
  fi
  target="$(resolve_ref "$ref")"
  prev="$(git -C "$RA_HOME" rev-parse HEAD)"
  if [[ "$target" == "$prev" ]]; then
    say "already at $ref ($(git -C "$RA_HOME" rev-parse --short=12 HEAD))"
    export_image_tag
    wait_healthy || die "the app is not healthy — see: racearena status"
    return 0
  fi
  say "── 1/6 backup before the update"
  cmd_backup
  archive="$(state_get last-backup)"
  say "── 2/6 fetch $ref ($target)"
  git -C "$RA_HOME" checkout --quiet --detach "$target"
  export_image_tag
  say "── 3/6 build the image racearena-app:$RA_IMAGE_TAG"
  compose build app
  say "── 4/6 stop the app and run the migrations"
  compose stop app
  if ! tool app node /scripts/migrate.mjs; then
    say "the migrations FAILED"
    rollback_to "$prev" "$archive"
    die "update to $ref failed in its migrations; rolled back (see above)"
  fi
  say "── 5/6 start"
  if website_mode; then refresh_sync_token; fi
  up_detached
  say "── 6/6 health"
  if wait_healthy; then
    state_set previous-ref "$prev"
    state_set previous-backup "$archive"
    say "updated to $ref ($RA_IMAGE_TAG). The backup taken before it: $RA_BACKUPS/$archive"
    return 0
  fi
  say "the app is NOT healthy within ${HEALTH_TIMEOUT_S}s after the update — rolling back automatically"
  rollback_to "$prev" "$archive"
  die "update to $ref failed its health check; ROLLED BACK to $(git -C "$RA_HOME" rev-parse --short=12 HEAD) and the backup $archive"
}

# Back to a commit and, when given, to a backup. Reuses the previous image when it still exists.
rollback_to() {
  local sha="$1" archive="${2:-}"
  git -C "$RA_HOME" checkout --quiet --detach "$sha"
  export_image_tag
  if ! docker image inspect "racearena-app:$RA_IMAGE_TAG" >/dev/null 2>&1; then
    compose build app
  fi
  if [[ -n "$archive" ]]; then
    restore_archive "$archive"
  else
    up_detached
  fi
  wait_healthy || die "rolled back to $RA_IMAGE_TAG, but it is not healthy either — see: racearena logs app"
  say "rolled back to $RA_IMAGE_TAG${archive:+ and the backup $archive}"
}

help_rollback() { say "racearena rollback — return to the version before the last update, and to its data.
  As docs/DEPLOYMENT.md 'Roll back a bad update' says: the app is stopped, the current data is MOVED
  aside (kept, not deleted — anything created since the update is in it), the backup taken just
  before the update is restored into the empty directory, and the previous version starts."; }
cmd_rollback() {
  require_installed
  local prev archive cur
  prev="$(state_get previous-ref)"
  archive="$(state_get previous-backup)"
  [[ -n "$prev" && -n "$archive" ]] || die "no previous version is recorded (no update has been made yet)"
  cur="$(git -C "$RA_HOME" rev-parse HEAD)"
  rollback_to "$prev" "$archive"
  state_set previous-ref "$cur"
}

help_version() { say "racearena version — the version this server runs, the one before it, and where things are."; }
cmd_version() {
  require_installed
  say "version:  $(git -C "$RA_HOME" describe --tags --always 2>/dev/null) ($(git -C "$RA_HOME" rev-parse --short=12 HEAD))"
  local prev
  prev="$(state_get previous-ref)"
  say "previous: ${prev:-none}"
  say "address:  $(grep -E '^RA_PUBLIC_ORIGIN=' "$RA_ETC/racearena.env" | cut -d= -f2-)"
  say "data:     $RA_DATA"
  say "backups:  $RA_BACKUPS"
}

# ── SSH hardening, guided (never run by install.sh) ──────────────────────────────────────────────
#
# ★ THE ONE COMMAND HERE THAT CAN LOCK THE OWNER OUT, so it proves the way back in BEFORE it closes
# the old one. Two phases, two sessions:
#   1. `harden-ssh --user <name>` (the first session): checks the user, prints the plan, and hands
#      out a one-time code. Nothing is changed.
#   2. `harden-ssh --confirm <code>` (a SECOND session, signed in as that user WITH A KEY, via sudo):
#      it finds that session's own SSH connection and requires sshd's "Accepted publickey" line for
#      exactly that client address and port. Only then are passwords and root sign-in switched off.
# Anything unproven is a refusal, and a refusal changes nothing.
SSHD_DROPIN="${RA_SSHD_DROPIN:-/etc/ssh/sshd_config.d/00-racearena-hardening.conf}"
HARDEN_TTL_S=900

help_harden_ssh() { say "racearena harden-ssh --user <name> [--dry-run]   then   racearena harden-ssh --confirm <code>
  Switches off password and root sign-in over SSH — but only after it has seen <name> (a non-root
  user who can use sudo) sign in WITH A KEY in a second session.
  1. sudo racearena harden-ssh --user <name>     checks <name>, prints the plan and a one-time code
  2. in a SECOND terminal, signed in as <name> with your key:
     sudo racearena harden-ssh --confirm <code>   proves that session used a key, then applies
  Keep the first session open until a third sign-in with the key works. --dry-run stops after the
  checks and the plan. Written to $SSHD_DROPIN; nothing else in the SSH configuration is touched."; }

harden_plan() {
  printf 'PasswordAuthentication no\nKbdInteractiveAuthentication no\nPermitRootLogin no\n'
}

# The checks of phase 1, every one a refusal. Echoes nothing on success.
harden_check_user() {
  local user="$1" entry uid home
  entry="$(getent passwd "$user" || true)"
  [[ -n "$entry" ]] || die "refused: there is no user '$user' on this server"
  uid="$(cut -d: -f3 <<<"$entry")"
  home="$(cut -d: -f6 <<<"$entry")"
  [[ "$uid" != 0 ]] || die "refused: '$user' is root — name the non-root user you will sign in as"
  id -nG "$user" | tr ' ' '\n' | grep -qxE 'sudo|admin|wheel' ||
    die "refused: '$user' cannot use sudo (not in the sudo group) — after this, root cannot sign in, so that user must be able to"
  grep -qE '^(ssh-|ecdsa-|sk-)' "$home/.ssh/authorized_keys" 2>/dev/null ||
    die "refused: '$user' has no public key in $home/.ssh/authorized_keys — add yours first (ssh-copy-id from your computer)"
  grep -qE '^[[:space:]]*Include[[:space:]]+/etc/ssh/sshd_config\.d/\*\.conf' /etc/ssh/sshd_config 2>/dev/null ||
    die "refused: /etc/ssh/sshd_config does not include sshd_config.d/*.conf, so a file there would be ignored"
}

# SSH_CONNECTION of the session this command was started from. sudo removes it from the
# environment, so it is read from the nearest ancestor process that still has it.
session_ssh_connection() {
  local pid="$$" conn
  while [[ "$pid" -gt 1 ]]; do
    conn="$(tr '\0' '\n' <"/proc/$pid/environ" 2>/dev/null | sed -n 's/^SSH_CONNECTION=//p' | head -n 1)"
    [[ -n "$conn" ]] && { printf '%s\n' "$conn"; return 0; }
    pid="$(awk '{print $4}' "/proc/$pid/stat" 2>/dev/null || echo 1)"
  done
  return 1
}

cmd_harden_ssh() {
  local user="" code="" dry=0
  while (($#)); do
    case "$1" in
      --user) user="${2:-}"; shift 2 ;;
      --confirm) code="${2:-}"; shift 2 ;;
      --dry-run) dry=1; shift ;;
      *) die "unknown argument: $1 (see racearena harden-ssh --help)" ;;
    esac
  done
  if [[ -n "$code" ]]; then harden_confirm "$code"; return; fi
  [[ -n "$user" ]] || die "usage: racearena harden-ssh --user <name>   (see --help)"
  ((dry)) || [[ "$(id -u)" == 0 ]] || die "run it with sudo"
  harden_check_user "$user"
  say "checks passed: '$user' is not root, can use sudo, and has a public key.
the plan — written to $SSHD_DROPIN, then 'sshd -t' and the effective settings are checked:"
  harden_plan | sed 's/^/    /'
  if ((dry)); then say "(dry run: nothing changed, no code issued)"; return 0; fi
  code="$(od -An -N4 -tx4 /dev/urandom | tr -d ' ')"
  state_set harden-ssh "$user $code $((EPOCHSECONDS + HARDEN_TTL_S))"
  chmod 600 "$RA_ETC/state/harden-ssh"
  say "
NOTHING IS CHANGED YET. Keep this session open, and in a SECOND terminal:
  1. sign in as $user WITH YOUR KEY:   ssh $user@$(hostname -f 2>/dev/null || hostname)
  2. run:                              sudo racearena harden-ssh --confirm $code
The code is valid for $((HARDEN_TTL_S / 60)) minutes."
}

harden_confirm() {
  local code="$1" user want expiry conn ip port accepted
  [[ "$(id -u)" == 0 ]] || die "run it with sudo"
  read -r user want expiry <<<"$(state_get harden-ssh)"
  [[ -n "${want:-}" ]] || die "refused: no plan is waiting — run 'racearena harden-ssh --user <name>' first"
  [[ "$code" == "$want" ]] || die "refused: that is not the code this server issued"
  ((EPOCHSECONDS <= expiry)) || die "refused: the code has expired — run 'racearena harden-ssh --user $user' again"
  [[ "${SUDO_USER:-}" == "$user" ]] || die "refused: run it as $user (signed in as $user, through sudo), not as ${SUDO_USER:-root}"
  conn="$(session_ssh_connection)" || die "refused: this is not an SSH session — open the second session over SSH"
  read -r ip port _ <<<"$conn"
  # sshd itself up to OpenSSH 9.7; from 9.8 the "Accepted" line comes from its sshd-session process.
  accepted="$(journalctl -q --no-pager --since '-1day' _COMM=sshd + _COMM=sshd-session 2>/dev/null |
    grep -E "Accepted [a-z-]+ for $user from $ip port $port( |$)" | tail -n 1 || true)"
  [[ -n "$accepted" ]] || die "refused: sshd has no record of how this session ($ip port $port) signed in"
  grep -q "Accepted publickey" <<<"$accepted" ||
    die "refused: this session signed in WITHOUT a key ($(grep -oE 'Accepted [a-z-]+' <<<"$accepted")) — sign in with your key and confirm from that session"
  say "proved: $user signed in from $ip port $port with a key."
  if [[ -e "$SSHD_DROPIN" ]]; then cp -p -- "$SSHD_DROPIN" "$SSHD_DROPIN.before-$(date -u +%Y%m%dT%H%M%SZ)"; fi
  harden_plan | install -m 644 /dev/stdin "$SSHD_DROPIN"
  local eff
  if ! sshd -t 2>/dev/null; then
    rm -f -- "$SSHD_DROPIN"
    die "refused: sshd rejected the configuration (sshd -t); the file was removed again, nothing changed"
  fi
  # First value wins in sshd: another drop-in read earlier would silently override this one.
  eff="$(sshd -T 2>/dev/null | grep -Ei '^(passwordauthentication|permitrootlogin|kbdinteractiveauthentication) ' | sort | tr '\n' ' ')"
  if [[ "$eff" != "kbdinteractiveauthentication no passwordauthentication no permitrootlogin no " ]]; then
    rm -f -- "$SSHD_DROPIN"
    die "refused: another SSH setting overrides this one (effective: $eff); the file was removed again, nothing changed"
  fi
  systemctl reload ssh 2>/dev/null || systemctl reload sshd
  rm -f -- "$RA_ETC/state/harden-ssh"
  say "done: password and root sign-in are OFF. Keep both sessions open and check that a THIRD sign-in
with your key works before closing either. To undo: sudo rm $SSHD_DROPIN && sudo systemctl reload ssh"
}

